  "cases": [
    {
      "id": "benign-json-body",
      "category": "body/benign",
      "request": {
        "method": "POST",
        "path_and_query": "/api/users",
        "headers": [["Content-Type", "application/json"]],
        "body": {
          "kind": "inline_utf8",
          "value": "{\"name\":\"John Doe\",\"email\":\"john@example.com\",\"age\":30}"
        }
      },
      "expectation": {
        "status_exact": 200
      }
    },
    {
